{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/l/(.*)", "destination": "/api/listing-page?slug=$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/listing-page.js": {
      "includeFiles": "public/listing.html"
    }
  },
  "crons": [
    {
      "path": "/api/digest?force=1",
      "schedule": "50 0 * * *"
    }
  ]
}
